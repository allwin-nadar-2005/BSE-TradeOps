# Server
PORT=4000

# Supabase — use the SERVICE ROLE key here (backend only, never exposed to the browser).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mock BSE API tuning
TOTAL_TRADES=4800
CHUNK_LIMIT=100
CHUNK_DELAY_MS=1500
MOCK_BSE_BASE_URL=http://localhost:4000

# TradeOps Copilot AI Chatbot Tuning (Google Gemini REST API)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
